integrator = md
nsteps = 6
dt = 0.004
cutoff-scheme = Verlet
nstlist = 2
verlet-buffer-tolerance = -1
rlist = 1.2
coulombtype = PME
rcoulomb = 1.2
fourierspacing = 0.12
pme-order = 4
vdwtype = cut-off
rvdw = 1.2
constraints = h-bonds
constraint-algorithm = lincs
lincs-order = 4
lincs-iter = 2
pbc = xyz
continuation = no
tcoupl = v-rescale
tc-grps = System
tau_t = 1.0
ref_t = 300
pcoupl = no
gen_vel = no
nstcalcenergy = 1000
nstenergy = 1000
nstlog = 1000
nstxout = 0
nstvout = 0
nstfout = 0
nstxout-compressed = 0
DispCorr = no
